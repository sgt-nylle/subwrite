#!/usr/bin/env bash
# ==============================================================================
# SubWrite! Server Status & Connection Monitor
# Displays live service status, health checks, and incoming Caddy access logs.
# ==============================================================================

set -e

# Terminal colors
BOLD="\033[1m"
GREEN="\033[1;32m"
RED="\033[1;31m"
YELLOW="\033[1;33m"
CYAN="\033[1;36m"
WHITE="\033[1;37m"
DIM="\033[2m"
RESET="\033[0m"

LOG_FILE="/var/log/caddy/subwrite_access.log"
SCORES_FILE="/var/www/subwrite/data/scores.json"
NUM_LINES=15

# Show usage
usage() {
    cat << EOF
Usage: subwrite-status [OPTIONS]

Options:
  -w, --watch        Run in continuous live dashboard mode (refreshes every 2s)
  -t, --tail         Stream new incoming connections in real time
  -n <number>        Number of recent connections to display (default: 15)
  -h, --help         Display this help message

Examples:
  subwrite-status            # Show instant status snapshot
  subwrite-status -w         # Live interactive monitoring dashboard
  subwrite-status -n 25      # Show last 25 connections
  subwrite-status -t         # Tail incoming requests in real time
EOF
    exit 0
}

# Parse flags
WATCH_MODE=false
TAIL_MODE=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        -w|--watch)
            WATCH_MODE=true
            shift
            ;;
        -t|--tail)
            TAIL_MODE=true
            shift
            ;;
        -n)
            NUM_LINES="$2"
            shift 2
            ;;
        -h|--help)
            usage
            ;;
        *)
            echo "Unknown option: $1"
            usage
            ;;
    esac
done

# Tail mode: stream live connections
if [ "$TAIL_MODE" = true ]; then
    echo -e "${CYAN}${BOLD}=== STREAMING INCOMING CONNECTIONS (Ctrl+C to exit) ===${RESET}"
    printf "%-19s | %-15s | %-5s | %-4s | %s\n" "DATE & TIME" "CLIENT IP" "MTHD" "STAT" "PATH / URI"
    echo "--------------------+-----------------+-------+------+-------------------------------------"
    
    if [ ! -f "$LOG_FILE" ]; then
        echo -e "${RED}Log file not found at $LOG_FILE${RESET}"
        exit 1
    fi

    tail -f -n "$NUM_LINES" "$LOG_FILE" | python3 -u -c '
import sys, json, datetime

for line in sys.stdin:
    line = line.strip()
    if not line: continue
    try:
        d = json.loads(line)
        ts = d.get("ts", 0)
        dt = datetime.datetime.fromtimestamp(ts).strftime("%Y-%m-%d %H:%M:%S") if ts else "---"
        req = d.get("request", {})
        ip = req.get("client_ip") or req.get("remote_ip", "---").split(":")[0]
        mthd = req.get("method", "GET")
        uri = req.get("uri", "/")
        status = d.get("status", 200)

        # ANSI color status
        if status < 300:
            stat_col = "\033[1;32m" + str(status) + "\033[0m"
        elif status < 400:
            stat_col = "\033[1;36m" + str(status) + "\033[0m"
        else:
            stat_col = "\033[1;31m" + str(status) + "\033[0m"

        print(f"{dt} | {ip:<15} | {mthd:<5} | {stat_col:<13} | {uri[:55]}")
    except:
        pass
'
    exit 0
fi

# Main dashboard rendering function
render_dashboard() {
    clear 2>/dev/null || true

    echo -e "${CYAN}${BOLD}======================================================================${RESET}"
    echo -e "${WHITE}${BOLD}         ★ SUBWRITE.SE - PRODUCTION SERVER STATUS DASHBOARD ★${RESET}"
    echo -e "${CYAN}${BOLD}======================================================================${RESET}"
    echo -e "${DIM}Host: $(hostname) • System Time: $(date '+%Y-%m-%d %H:%M:%S %Z')${RESET}"
    echo ""

    # 1. Services Status
    echo -e "${WHITE}${BOLD}[ SYSTEM SERVICES ]${RESET}"

    # Caddy Status
    if systemctl is-active --quiet caddy.service; then
        echo -e "  Caddy Web Server   : ${GREEN}● ACTIVE (RUNNING)${RESET} - Reverse Proxy & Static Cache"
    else
        echo -e "  Caddy Web Server   : ${RED}▲ STOPPED / INACTIVE${RESET}"
    fi

    # Node.js Service Status
    if systemctl is-active --quiet subwrite.service; then
        PID=$(systemctl show -p MainPID --value subwrite.service 2>/dev/null || echo "N/A")
        echo -e "  Node.js Backend    : ${GREEN}● ACTIVE (RUNNING)${RESET} - PID ${PID} on port 3000"
    else
        echo -e "  Node.js Backend    : ${RED}▲ STOPPED / INACTIVE${RESET}"
    fi

    # HTTPS Public Endpoint
    HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 2 https://subwrite.se/ || echo "ERR")
    if [ "$HTTP_CODE" = "200" ]; then
        echo -e "  Public Endpoint    : ${GREEN}● ONLINE${RESET} (https://subwrite.se -> HTTP ${HTTP_CODE} OK)"
    elif [ "$HTTP_CODE" = "ERR" ]; then
        echo -e "  Public Endpoint    : ${YELLOW}▲ TIMEOUT / UNREACHABLE${RESET}"
    else
        echo -e "  Public Endpoint    : ${YELLOW}● HTTP ${HTTP_CODE}${RESET} (https://subwrite.se)"
    fi

    # Scores Database Check
    if [ -f "$SCORES_FILE" ]; then
        SCORE_COUNT=$(python3 -c "import json; data=json.load(open('$SCORES_FILE')); print(len(data))" 2>/dev/null || echo "0")
        echo -e "  Scores Database    : ${CYAN}${SCORE_COUNT} high-score records${RESET} stored (/var/www/subwrite/data/scores.json)"
    fi

    echo ""

    # 2. System Resources
    echo -e "${WHITE}${BOLD}[ SERVER RESOURCES ]${RESET}"
    UPTIME=$(uptime -p 2>/dev/null || uptime | awk -F'( |,|:)+' '{print $6,$7",",$8,"hours"}')
    LOAD=$(cat /proc/loadavg 2>/dev/null | awk '{print $1", "$2", "$3}' || echo "N/A")
    MEM=$(free -h 2>/dev/null | awk 'NR==2 {print $3 "/" $2}')
    DISK=$(df -h / 2>/dev/null | awk 'NR==2 {print $3 "/" $2 " (" $5 ")"}')

    echo -e "  Uptime: ${CYAN}${UPTIME}${RESET}  |  CPU Load: ${CYAN}${LOAD}${RESET}"
    echo -e "  Memory: ${CYAN}${MEM}${RESET}  |  Root Disk: ${CYAN}${DISK}${RESET}"
    echo ""

    # 3. Recent Connections
    echo -e "${WHITE}${BOLD}[ RECENT INCOMING CONNECTIONS ]${RESET} (Last ${NUM_LINES} from Caddy access log)"

    if [ ! -f "$LOG_FILE" ]; then
        echo -e "  ${YELLOW}No access log found at ${LOG_FILE}.${RESET}"
    else
        printf "  ${BOLD}%-19s | %-16s | %-5s | %-6s | %s${RESET}\n" "DATE & TIME" "CLIENT IP" "MTHD" "STATUS" "PATH / URI"
        echo "  --------------------+------------------+-------+--------+----------------------------"
        
        python3 -c "
import json, os, datetime

log_file = '$LOG_FILE'
lines = []
if os.path.exists(log_file):
    try:
        with open(log_file, 'r', encoding='utf-8', errors='ignore') as f:
            for l in f:
                l = l.strip()
                if not l: continue
                try:
                    d = json.loads(l)
                    ts = d.get('ts', 0)
                    dt = datetime.datetime.fromtimestamp(ts).strftime('%Y-%m-%d %H:%M:%S') if ts else '---'
                    req = d.get('request', {})
                    ip = req.get('client_ip') or req.get('remote_ip', '---').split(':')[0]
                    mthd = req.get('method', 'GET')
                    uri = req.get('uri', '/')
                    status = d.get('status', 200)
                    lines.append((dt, ip, mthd, status, uri))
                except:
                    pass
    except Exception as e:
        pass

for dt, ip, mthd, status, uri in lines[-$NUM_LINES:]:
    # ANSI color status
    if status < 300:
        stat_col = '\033[1;32m' + str(status) + '\033[0m'
    elif status < 400:
        stat_col = '\033[1;36m' + str(status) + '\033[0m'
    else:
        stat_col = '\033[1;31m' + str(status) + '\033[0m'

    print(f'  {dt} | {ip:<16} | {mthd:<5} | {stat_col:<15} | {uri[:45]}')
"
    fi
    echo ""
    echo -e "${DIM}Run 'subwrite-status -w' for live refresh, or 'subwrite-status -t' to stream requests.${RESET}"
}

if [ "$WATCH_MODE" = true ]; then
    while true; do
        render_dashboard
        sleep 2
    done
else
    render_dashboard
fi
